# ============================================================
# RAG 教程环境变量模板（第 3 课启用）
# 使用方法：
#   1. cp .env.example .env
#   2. 把下面的 sk-xxx 替换成你在 https://platform.xiaomimimo.com/console/api-keys
#      申请到的真实 API Key
#   3. .env 已被 .gitignore 忽略，绝对不会被提交
#
# 安全提醒：
#   - 不要把真实 Key 写进任何 .py / .md / .ipynb 文件
#   - 不要把 Key 贴到公开 issue / PR / 截图里
#   - 一旦泄露，立刻去控制台撤销并重新生成
# ============================================================

# 小米 MiMo 开放平台 API Key
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容协议根路径（一般无需修改）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 默认使用的模型（也可在代码里覆盖）
MIMO_MODEL=mimo-v2.5-pro
